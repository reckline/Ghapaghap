<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Transaction History | Ghapaghap</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Sharp" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#0b0b0b] text-gray-200 antialiased">

    <div class="flex h-screen overflow-hidden">
        <%- include('../partials/adminNav') %>

        <main class="flex-1 h-full overflow-y-auto relative">
            <%- include('../partials/adminHeader') %>

            
<div class="p-4 md:p-10 max-w-[1400px] mx-auto min-h-screen">
    
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10">
        <div>
            <h1 class="text-3xl font-black text-white tracking-tighter uppercase italic">
                Settled <span class="text-pink-600">Logs</span>
            </h1>
            <p class="text-[10px] text-zinc-500 font-black uppercase tracking-[0.3em] mt-1">Audit Trail: Approved & Rejected Only</p>
        </div>

        <div class="flex items-center gap-4">
            <div class="bg-zinc-900/50 border border-white/5 px-4 py-2 rounded-2xl">
                <p class="text-[9px] font-black text-zinc-500 uppercase tracking-widest">Processed</p>
                <p class="text-lg font-black text-white tabular-nums">
                    <%= deposits.filter(d => d.status !== 'Pending').length %>
                </p>
            </div>
        </div>
    </div>

<div class="bg-zinc-900/20 p-3 rounded-[2rem] border border-white/5 mb-8 backdrop-blur-md">
    <form action="/admin/depositInfos" method="GET" class="flex flex-col sm:flex-row items-center gap-3">
        <div class="flex flex-1 items-center gap-3 bg-black/40 px-5 py-3 rounded-2xl border border-white/5 w-full">
            <div class="flex items-center gap-4 w-full">
                <div class="flex flex-col w-full">
                    <label class="text-[8px] uppercase text-zinc-500 ml-1 mb-1 font-bold">From Date</label>
                    <input type="date" name="fromDate" value="<%= filters.fromDate %>" 
                           class="bg-transparent text-[11px] font-bold text-white focus:outline-none w-full uppercase cursor-pointer">
                </div>
                
                <span class="text-zinc-800 font-bold mt-4">to</span>
                
                <div class="flex flex-col w-full">
                    <label class="text-[8px] uppercase text-zinc-500 ml-1 mb-1 font-bold">To Date</label>
                    <input type="date" name="toDate" value="<%= filters.toDate %>" 
                           class="bg-transparent text-[11px] font-bold text-white focus:outline-none w-full uppercase cursor-pointer">
                </div>
            </div>
        </div>
        <button type="submit" class="w-full sm:w-auto bg-white text-black hover:bg-pink-600 hover:text-white px-10 py-4 rounded-2xl font-black text-xs uppercase transition-all shadow-lg active:scale-95">
            <i class="fas fa-search mr-2"></i> Filter Logs
        </button>
        <a href="/admin/depositInfos" class="p-4 bg-zinc-800 rounded-2xl text-zinc-400 hover:text-white transition-all">
            <i class="fas fa-sync-alt"></i>
        </a>
    </form>
</div>

    <div class="bg-zinc-900/10 rounded-[2.5rem] border border-white/5 overflow-hidden shadow-2xl">
        <div class="overflow-x-auto">
            <table class="w-full text-left min-w-[800px]">
                <thead class="bg-black/40 text-zinc-500 text-[10px] font-black uppercase tracking-[0.2em] border-b border-white/5">
                    <tr>
                        <th class="px-8 py-5">User Account</th>
                        <th class="px-8 py-5 text-center">Final Status</th>
                        <th class="px-8 py-5">Value</th>
                        <th class="px-8 py-5">Transaction ID</th>
                        <th class="px-8 py-5">Audit Timestamp</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/[0.03]">
                    <% deposits.filter(d => d.status !== 'Pending').forEach(log => { %>
                    <tr class="hover:bg-white/[0.02] transition-colors group">
                        <td class="px-8 py-6">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-zinc-800/50 flex items-center justify-center font-black text-zinc-500 border border-white/5">
                                    <%= log.user?.fullname ? log.user.fullname[0] : '?' %>
                                </div>
                                <div>
                                    <p class="text-sm font-bold text-white leading-tight"><%= log.user?.fullname || 'System User' %></p>
                                    <p class="text-[10px] text-zinc-600 font-mono tracking-tighter">ID: <%= log.user?._id.toString().slice(-6) %></p>
                                </div>
                            </div>
                        </td>

                        <td class="px-8 py-6">
                            <div class="flex justify-center">
                                <% if(log.status === 'Approved') { %>
                                    <span class="flex items-center gap-2 text-[10px] font-black uppercase tracking-tighter text-green-500 bg-green-500/10 px-4 py-1.5 rounded-full border border-green-500/20 shadow-[0_0_15px_rgba(34,197,94,0.1)]">
                                        <i class="fas fa-check-circle text-[8px]"></i> Accepted
                                    </span>
                                <% } else { %>
                                    <span class="flex items-center gap-2 text-[10px] font-black uppercase tracking-tighter text-red-500 bg-red-500/10 px-4 py-1.5 rounded-full border border-red-500/20 shadow-[0_0_15px_rgba(239,68,68,0.1)]">
                                        <i class="fas fa-times-circle text-[8px]"></i> Rejected
                                    </span>
                                <% } %>
                            </div>
                        </td>

                        <td class="px-8 py-6">
                            <span class="text-lg font-black text-white italic tabular-nums">₹<%= log.amount.toLocaleString('en-IN') %></span>
                        </td>

                        <td class="px-8 py-6">
                            <code class="text-[11px] font-mono text-zinc-500 bg-black/40 px-3 py-1 rounded-lg border border-white/5 tracking-tighter">
                                <%= log.transactionId %>
                            </code>
                        </td>

                        <td class="px-8 py-6 text-right">
                            <p class="text-xs font-bold text-zinc-400"><%= new Date(log.createdAt).toLocaleDateString('en-GB', {day: '2-digit', month: 'short', year: 'numeric'}) %></p>
                            <p class="text-[10px] text-zinc-600 font-medium uppercase mt-0.5"><%= new Date(log.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></p>
                        </td>
                    </tr>
                    <% }) %>

                    <% if(deposits.filter(d => d.status !== 'Pending').length === 0) { %>
                    <tr>
                        <td colspan="5" class="py-24 text-center">
                            <div class="opacity-20 flex flex-col items-center">
                                <i class="fas fa-folder-open text-5xl mb-4"></i>
                                <p class="text-[10px] font-black uppercase tracking-[0.5em]">No Settled Data Found</p>
                            </div>
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
            
        </main>
    </div>

    
<style>
    /* Responsive Scrollbar */
    .overflow-x-auto::-webkit-scrollbar { height: 4px; }
    .overflow-x-auto::-webkit-scrollbar-track { background: transparent; }
    .overflow-x-auto::-webkit-scrollbar-thumb { background: #27272a; border-radius: 10px; }

    input[type="date"]::-webkit-calendar-picker-indicator { filter: invert(1); cursor: pointer; opacity: 0.5; }
</style>
        <script>
        const menuBtn = document.getElementById('menu-btn');
        const sidebar = document.getElementById('sidebar');

        menuBtn.addEventListener('click', () => {
            sidebar.classList.toggle('-translate-x-full');
        });

        // Close sidebar when clicking outside on mobile
        document.addEventListener('click', (e) => {
            if (!sidebar.contains(e.target) && !menuBtn.contains(e.target) && window.innerWidth < 768) {
                sidebar.classList.add('-translate-x-full');
            }
        });
    </script>
</body>
</html>