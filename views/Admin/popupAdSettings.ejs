            document.getElementById('input-title').value = title;
            document.getElementById('input-message').value = message;
            document.getElementById('input-image').value = imageUrl;
            document.getElementById('input-link').value = link;
            document.getElementById('input-active').checked = (isActive === true || isActive === 'true');
            
            // Fill Preview
            document.getElementById('preview-title').innerText = title;
            document.getElementById('preview-message').innerText = message;
            document.getElementById('preview-image').src = imageUrl;
            document.getElementById('file-label').innerText = "Image Loaded ✅";
            
            modal.classList.remove('hidden');
        }

        function closeModal() {
            modal.classList.add('hidden');
        }

        // 1. Live Text Preview
        document.getElementById('input-title').addEventListener('input', (e) => document.getElementById('preview-title').innerText = e.target.value || 'Ad Title');
        document.getElementById('input-message').addEventListener('input', (e) => document.getElementById('preview-message').innerText = e.target.value || 'Description...');
        document.getElementById('input-link').addEventListener('input', (e) => {
            const btn = document.getElementById('preview-action-btn');
            btn.innerText = e.target.value ? "CHECK LINK" : "Action";
        });

        // 2. Upload Logic
        const fileInput = document.getElementById('file-upload');
        const fileLabel = document.getElementById('file-label');
        const hiddenImgInput = document.getElementById('input-image');
        const previewImg = document.getElementById('preview-image');
        const statusText = document.getElementById('upload-status');
        const loader = document.getElementById('image-loader');

        fileInput.addEventListener('change', async function() {
            if (this.files && this.files[0]) {
                const file = this.files[0];
                fileLabel.innerText = "⏳ Processing...";
                loader.style.opacity = '1';
                statusText.innerText = "⏳ Uploading to Server...";

                const formData = new FormData();
                formData.append('image', file);
                formData.append('api_key', "SECRET123");

                try {
                    const response = await fetch("https://24carret.in/upload.php", { method: 'POST', body: formData });
                    const data = await response.json();
                    const finalUrl = data.url || data.link || data.message;

                    if (finalUrl && finalUrl.startsWith('http')) {
                        hiddenImgInput.value = finalUrl;
                        previewImg.src = finalUrl;
                        fileLabel.innerText = "✅ " + file.name;
                        statusText.innerText = "✅ Uploaded successfully!";
                        statusText.className = "text-[9px] mt-1 ml-1 text-green-400 font-bold";
                    } else {
                        throw new Error("Invalid response from server");
                    }
                } catch (error) {
                    statusText.innerText = "❌ Upload Failed!";
                    fileLabel.innerText = "❌ Error occurred";
                } finally {
                    loader.style.opacity = '0';
                }
            }
        });
    </script>

    <script>
        // Sidebar Control
        const menuBtn = document.getElementById('menu-btn');
        const sidebar = document.getElementById('sidebar');

        if(menuBtn) {
            menuBtn.addEventListener('click', () => {
                sidebar.classList.toggle('-translate-x-full');
            });
        }

        document.addEventListener('click', (e) => {
            if (sidebar && !sidebar.contains(e.target) && menuBtn && !menuBtn.contains(e.target) && window.innerWidth < 768) {
                sidebar.classList.add('-translate-x-full');
            }
        });
    </script>
    
</body>
</html>