            adForm.reset();
            document.getElementById('preview-image').src = "https://via.placeholder.com/400x200?text=Ad+Preview";
            document.getElementById('preview-title').innerText = "Ad Title";
            document.getElementById('preview-message').innerText = "Description will appear here...";
            document.getElementById('file-label').innerText = "Click to Upload";
            modal.classList.remove('hidden');
