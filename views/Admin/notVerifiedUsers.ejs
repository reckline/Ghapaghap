<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Unverified Users | Ghapaghp Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Sharp" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
        .glass { background: rgba(26, 26, 26, 0.8); backdrop-filter: blur(12px); }
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #0f0f0f; }
        ::-webkit-scrollbar-thumb { background: #3b82f6; border-radius: 10px; }
    </style>
</head>
<body class="bg-[#0b0b0b] text-gray-200 antialiased">

    <div class="flex h-screen overflow-hidden">
         <%- include('../partials/adminNav') %>

        <main class="flex-1 h-full overflow-y-auto custom-scrollbar relative">
            <%- include('../partials/adminHeader') %>

            <div class="max-w-7xl mx-auto p-6">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                    <div>
                        <h1 class="text-2xl font-bold flex items-center gap-2">
                            <i class="fas fa-user-slash text-red-500"></i> Non-Verified Users
                        </h1>
                        <p class="text-gray-400 text-sm">Total <span class="text-red-500 font-bold"><%= users.length %></span> unverified accounts</p>
                    </div>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-500">
                            <i class="fas fa-search"></i>
                        </span>
                        <input type="text" id="userSearch" placeholder="Search unverified users..." 
                            class="bg-[#1a1a1a] border border-gray-800 rounded-lg pl-10 pr-4 py-2 text-sm focus:outline-none focus:border-red-500 w-full md:w-80 transition-all">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="usersGrid">
                    <% if (users && users.length > 0) { %>
                        <% users.forEach(u => { %>
                            <div class="user-card bg-[#1a1a1a] border border-gray-800 rounded-2xl p-5 hover:border-red-500/50 transition-all duration-300">
                                <div class="flex items-center justify-between mb-4">
                                    <div class="flex items-center gap-4">
                                        <img src="<%= u.avatar %>" alt="Avatar" class="w-14 h-14 rounded-full object-cover border-2 border-gray-700">
                                        <div class="overflow-hidden">
                                            <h3 class="name-field font-bold truncate text-lg"><%= u.fullname || 'Unknown User' %></h3>
                                            <p class="username-field text-gray-500 text-sm truncate">@<%= u.username || 'user' %></p>
                                        </div>
                                    </div>
                                    <span class="text-[10px] px-2 py-1 rounded-full font-bold uppercase tracking-tighter
                                        <%= u.verificationStatus === 'Pending' ? 'bg-yellow-500/10 text-yellow-500' : 
                                           u.verificationStatus === 'Rejected' ? 'bg-red-500/10 text-red-500' : 'bg-gray-500/10 text-gray-400' %>">
                                        <%= u.verificationStatus || 'No Request' %>
                                    </span>
                                </div>

                                <div class="space-y-2 mb-6">
                                    <div class="flex items-center text-xs text-gray-400 gap-2">
                                        <i class="fas fa-envelope w-4 text-gray-600"></i>
                                        <span class="truncate"><%= u.email %></span>
                                    </div>
                                    <div class="flex items-center text-xs text-gray-400 gap-2">
                                        <i class="fas fa-calendar-alt w-4 text-gray-600"></i>
                                        <span>Joined: <%= new Date(u.createdAt).toLocaleDateString('en-IN') %></span>
                                    </div>
                                </div>

                                <div class="flex items-center justify-between pt-4 border-t border-gray-800/50">
                                    <div class="flex flex-col">
                                        <p class="text-[10px] text-gray-500 uppercase">Subscribers</p>
                                        <p class="font-bold text-gray-300"><%= u.subscribersCount || 0 %></p>
                                    </div>
                                    <a href="/admin/user/<%= u._id %>" class="bg-red-500/10 hover:bg-red-500 text-red-500 hover:text-white px-4 py-1.5 rounded-lg text-xs font-bold transition-all">
                                        View & Action
                                    </a>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="col-span-full py-20 text-center bg-[#1a1a1a] rounded-2xl border border-dashed border-gray-800">
                            <i class="fas fa-users-slash text-5xl text-gray-700 mb-4"></i>
                            <p class="text-gray-400 text-lg font-medium">All users are verified!</p>
                            <p class="text-gray-600 text-sm">No unverified accounts found in the database.</p>
                        </div>
                    <% } %>
                </div>

                <div id="noResults" class="hidden col-span-full py-20 text-center bg-[#1a1a1a] rounded-2xl border border-dashed border-gray-800">
                    <i class="fas fa-search text-4xl text-gray-700 mb-3"></i>
                    <p class="text-gray-500">No matching unverified users found.</p>
                </div>
            </div>
        </main>
    </div>

    <script>

        const menuBtn = document.getElementById('menu-btn');

        const sidebar = document.getElementById('sidebar');



        menuBtn.addEventListener('click', () => {

            sidebar.classList.toggle('-translate-x-full');

        });



        // Close sidebar when clicking outside on mobile

        document.addEventListener('click', (e) => {

            if (!sidebar.contains(e.target) && !menuBtn.contains(e.target) && window.innerWidth < 768) {

                sidebar.classList.add('-translate-x-full');

            }

        });

    </script>

    <script>
        document.getElementById('userSearch').addEventListener('input', function(e) {
            const term = e.target.value.toLowerCase().trim();
            const cards = document.querySelectorAll('.user-card');
            const noResults = document.getElementById('noResults');
            let hasVisibleCards = false;

            cards.forEach(card => {
                const name = card.querySelector('.name-field').innerText.toLowerCase();
                const username = card.querySelector('.username-field').innerText.toLowerCase();
                
                if(name.includes(term) || username.includes(term)) {
                    card.style.display = 'block';
                    hasVisibleCards = true;
                } else {
                    card.style.display = 'none';
                }
            });

            if (term !== "" && !hasVisibleCards) {
                noResults.classList.remove('hidden');
            } else {
                noResults.classList.add('hidden');
            }
        });
    </script>
</body>
</html>