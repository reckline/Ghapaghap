<% if (activeAds && activeAds.length > 0) { %>
    <div id="globalPopup" class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/80 backdrop-blur-sm p-4 opacity-0 pointer-events-none transition-all duration-500">
        <div class="bg-white rounded-[2rem] overflow-hidden max-w-sm w-full shadow-2xl relative transform scale-90 transition-all duration-500" id="popupCard">
            
            <button onclick="closeGlobalPopup()" class="absolute top-3 right-3 bg-black/20 hover:bg-black/40 text-white w-8 h-8 rounded-full flex items-center justify-center z-20">✕</button>
            
            <div id="adContainer">
                <% activeAds.forEach((ad, index) => { %>
                    <div class="ad-slide hidden opacity-0 transition-opacity duration-500" data-index="<%= index %>">
                        <img src="<%= ad.imageUrl %>" class="w-full h-48 object-cover">
                        <div class="p-6 text-center">
                            <span class="text-[10px] bg-pink-100 text-pink-600 px-2 py-0.5 rounded-full font-bold uppercase mb-2 inline-block">Special Offer</span>
                            <h3 class="text-xl font-black text-slate-900 uppercase leading-tight"><%= ad.title %></h3>
                            <p class="text-gray-500 text-sm my-3 italic line-clamp-2"><%= ad.message %></p>
                            <!-- <a href="<%= ad.link %>" class="inline-block w-full py-3 bg-gradient-to-r from-pink-600 to-purple-600 text-white font-bold rounded-xl tracking-wider hover:shadow-lg transition-all active:scale-95">
                                VIEW DETAILS
                            </a> -->
                            <% 
   // Check karo ki link http se shuru hota hai ya nahi
   let finalLink = ad.link;
   if (finalLink && !finalLink.startsWith('http://') && !finalLink.startsWith('https://')) {
       finalLink = 'https://' + finalLink;
   }
%>

<a href="<%= finalLink %>" target="_blank" class="inline-block w-full py-3 bg-gradient-to-r from-pink-600 to-purple-600 text-white font-bold rounded-xl tracking-wider hover:shadow-lg transition-all active:scale-95 text-center">
    VIEW DETAILS
</a>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>

    <script>
        window.addEventListener('load', () => {
            const slides = document.querySelectorAll('.ad-slide');
            const totalAds = slides.length;

            if (totalAds > 0) {
                // 🎲 RANDOM LOGIC: Randomly select an index
                const randomIndex = Math.floor(Math.random() * totalAds);
                
                // Show the random slide
                const selectedSlide = slides[randomIndex];
                selectedSlide.classList.remove('hidden');
                setTimeout(() => selectedSlide.classList.add('opacity-100'), 50);

                // Show the main popup after 2 seconds
                setTimeout(() => {
                    document.getElementById('globalPopup').classList.remove('opacity-0', 'pointer-events-none');
                    document.getElementById('popupCard').classList.remove('scale-90');
                }, 2000);
            }
        });

        function closeGlobalPopup() {
            const popup = document.getElementById('globalPopup');
            const card = document.getElementById('popupCard');
            card.classList.add('scale-90');
            popup.classList.add('opacity-0', 'pointer-events-none');
        }
    </script>
<% } %>