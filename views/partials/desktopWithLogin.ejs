<aside class="hidden lg:flex flex-col w-64 fixed top-16 left-0 h-[calc(100vh-4rem)] bg-[#0f0f0f] p-4 border-r border-gray-800/40">
    <div class="space-y-2 overflow-y-auto custom-scrollbar">
        
        <div class="space-y-1">
            <a href="/profile" class="flex items-center gap-4 p-3 rounded-xl transition-all duration-300 <%= currentPath === '/profile' ? 'bg-pink-600/10 text-pink-500 font-bold' : 'text-gray-400 hover:bg-white/5 hover:text-white' %>">
    <i class="fas fa-circle-user w-5 text-center"></i> 
    <span class="text-sm">My Profile</span>
</a>
            <a href="/" class="flex items-center gap-4 p-3 rounded-xl transition-all duration-300 <%= currentPath === '/' ? 'bg-pink-600/10 text-pink-500 font-bold' : 'text-gray-400 hover:bg-white/5 hover:text-white' %>">
                <i class="fas fa-home w-5 text-center"></i>
                <span class="text-sm">Home</span>
            </a>
            
            <a href="/shorts" class="flex items-center gap-4 p-3 rounded-xl transition-all duration-300 <%= currentPath === '/shorts' ? 'bg-pink-600/10 text-pink-500 font-bold' : 'text-gray-400 hover:bg-white/5 hover:text-white' %>">
                <i class="fas fa-bolt w-5 text-center"></i>
                <span class="text-sm">Shorts</span>
            </a>

            <a href="/live" class="flex items-center gap-4 p-3 rounded-xl transition-all duration-300 <%= currentPath === '/live' ? 'bg-pink-600/10 text-pink-500 font-bold' : 'text-gray-400 hover:bg-white/5 hover:text-white' %>">
                <i class="fas fa-broadcast-tower w-5 text-center"></i>
                <span class="text-sm">Live Room</span>
            </a>
        </div>

        <hr class="border-gray-800/50 my-4 mx-2" />
        
        <div>
            <p class="text-[10px] uppercase font-black text-gray-600 px-3 mb-2 tracking-[0.2em]">Personal</p>
            
            <a href="/allCreaters" class="flex items-center gap-4 p-3 rounded-xl transition-all duration-300 <%= currentPath === '/allCreaters' ? 'bg-pink-600/10 text-pink-500 font-bold' : 'text-gray-400 hover:bg-white/5 hover:text-white' %>">
                <i class="fas fa-users w-5 text-center"></i>
                <span class="text-sm font-medium">All Creators</span>
            </a>

            <% if (user && user.isVerified) { %>
                <a href="/myVideos" class="flex items-center gap-4 p-3 rounded-xl transition-all duration-300 group <%= currentPath === '/myVideos' ? 'bg-pink-600/10 text-pink-500 font-bold' : 'text-gray-400 hover:bg-white/5 hover:text-white' %>">
                    <i class="fas fa-video w-5 text-center group-hover:text-pink-500 transition-colors"></i>
                    <span class="text-sm font-medium">My Videos</span>
                    <span class="ml-auto w-2 h-2 rounded-full bg-pink-600 shadow-[0_0_8px_#db2777]"></span>
                </a>
            <% } %>

            
        </div>

        <hr class="border-gray-800/50 my-4 mx-2" />

        <div class="mt-auto pb-4">
            <a href="/logout" class="flex items-center gap-4 p-3 rounded-xl transition-all duration-300 text-red-500/70 hover:bg-red-500/10 hover:text-red-500 group">
                <i class="fas fa-right-from-bracket w-5 text-center transition-transform group-hover:translate-x-1"></i>
                <span class="text-sm font-bold uppercase tracking-wider">Logout</span>
            </a>
        </div>
    </div>
</aside>