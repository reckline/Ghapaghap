<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ghapagap - Change Password</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .bg-pink-theme { background-color: rgb(240, 119, 139); }
        .shadow-pink { box-shadow: 0 10px 25px -5px rgba(240, 119, 139, 0.4); }
        body { background-color: black; color: white; font-family: 'Inter', sans-serif; }
        .glass-card {
            background: rgba(24, 24, 27, 0.8);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        input::-ms-reveal, input::-ms-clear { display: none; }
        
        .loader {
            border: 2px solid #f3f3f3;
            border-top: 2px solid rgb(240, 119, 139);
            border-radius: 50%;
            width: 16px;
            height: 16px;
            animation: spin 1s linear infinite;
            display: inline-block;
            margin-right: 8px;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body class="min-h-screen bg-black flex flex-col items-center p-4 md:p-8">

    <div class="w-full max-w-md glass-card rounded-[2.5rem] p-8 md:p-10 shadow-2xl mt-10">
        <div class="flex items-center justify-between mb-8">
            <h1 class="text-2xl font-black tracking-tight">Security</h1>
            <a href="/profile" class="w-8 h-8 flex items-center justify-center rounded-full bg-zinc-800 hover:bg-zinc-700 transition-all">
                <i class="fas fa-times text-xs"></i>
            </a>
        </div>

        <h2 class="text-xl font-bold mb-2">Change Password</h2>
        <p class="text-gray-400 text-sm mb-8">Ensure your account is using a long, random password to stay secure.</p>

        <form action="/update-password" method="POST" id="passwordForm" class="space-y-6">
            
            <div class="space-y-2">
                <label class="text-sm font-bold text-gray-400 ml-1">Current Password</label>
                <div class="relative">
                    <input type="password" name="currentPassword" id="currentPassword" required 
                        class="w-full px-5 py-4 bg-black/40 border border-white/10 rounded-2xl focus:ring-2 focus:ring-pink-400 outline-none transition-all pr-12">
                    <button type="button" onclick="togglePassword('currentPassword', this)" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-pink-400 transition-colors">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>

            <div class="space-y-2">
                <label class="text-sm font-bold text-gray-400 ml-1">New Password</label>
                <div class="relative">
                    <input type="password" name="newPassword" id="newPassword" required 
                        class="w-full px-5 py-4 bg-black/40 border border-white/10 rounded-2xl focus:ring-2 focus:ring-pink-400 outline-none transition-all pr-12">
                    <button type="button" onclick="togglePassword('newPassword', this)" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-pink-400 transition-colors">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>

            <div class="space-y-2">
                <label class="text-sm font-bold text-gray-400 ml-1">Confirm New Password</label>
                <div class="relative">
                    <input type="password" name="confirmPassword" id="confirmPassword" required 
                        class="w-full px-5 py-4 bg-black/40 border border-white/10 rounded-2xl focus:ring-2 focus:ring-pink-400 outline-none transition-all pr-12">
                    <button type="button" onclick="togglePassword('confirmPassword', this)" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-pink-400 transition-colors">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>

            <button type="submit" id="submitBtn" class="w-full bg-pink-theme text-white py-4 rounded-2xl font-black text-lg shadow-pink hover:scale-[1.02] transition-all uppercase tracking-widest mt-4">
                Update Password
            </button>
        </form>
    </div>

    <script>
        // --- 1. Toast Notification Logic with Auto-Redirect ---
        const urlParams = new URLSearchParams(window.location.search);
        const successMsg = urlParams.get('success');
        const errorMsg = urlParams.get('error');

        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            background: '#18181b',
            color: '#ffffff'
        });

        if (successMsg === 'password_updated') {
            Toast.fire({ 
                icon: 'success', 
                title: 'Password badal gaya!' 
            }).then(() => {
                // ✨ Success hone ke baad redirect
                window.location.href = '/profile';
            });
        } else if (errorMsg) {
            Toast.fire({ 
                icon: 'error', 
                title: decodeURIComponent(errorMsg) 
            });
        }
        
        // URL cleanup
        if (successMsg || errorMsg) {
            window.history.replaceState({}, document.title, window.location.pathname);
        }

        // --- 2. Password Visibility Toggle ---
        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            const icon = button.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }

        // --- 3. Loading State on Submit ---
        document.getElementById('passwordForm').addEventListener('submit', function() {
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="loader"></span> Processing...';
        });
    </script>
</body>
</html>