<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Sharp" rel="stylesheet">
    <title><%= creator.username %> | GhapaGhap</title>
    <style>
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #0f0f0f; }
        ::-webkit-scrollbar-thumb { background: #333; border-radius: 10px; }
        #mobile-sidebar { transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .tab-active { border-bottom: 2px solid #db2777; color: white !important; }
    </style>
</head>
<body class="bg-[#0f0f0f] text-white font-sans antialiased selection:bg-pink-500/30">

    <div id="sidebar-overlay" class="fixed inset-0 bg-black/70 z-[70] hidden opacity-0 transition-opacity duration-300"></div>

    <aside id="mobile-sidebar" class="fixed top-0 left-0 w-72 h-full bg-[#0f0f0f] z-[80] -translate-x-full border-r border-gray-800 p-5 overflow-y-auto">
        <% if (user) { %>
            <%- include('../partials/mobWithLogin') %>
        <% } else { %>
            <%- include('../partials/mobWithoutLogin') %>
        <% } %>
    </aside>

    <nav class="fixed top-0 z-50 w-full bg-[#0f0f0f]/90 backdrop-blur-md flex items-center justify-between px-4 h-16 border-b border-gray-800">
        <% if (user) { %>
            <%- include('../partials/headerWithLogin') %>
        <% } else { %>
            <%- include('../partials/headerWithoutLogin') %>
        <% } %>
    </nav>

    <div class="flex">
        <% if (user) { %>
            <%- include('../partials/desktopWithLogin') %>
        <% } else { %>
            <%- include('../partials/desktopWithoutLogin') %>
        <% } %>

        <main class="flex-1 lg:ml-64 mt-16 pt-4 md:p-8 pb-24">
            
            <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center md:items-start gap-8 border-b border-gray-800/50 pb-12">
                <div class="relative group">
                    <div class="absolute -inset-1 bg-gradient-to-tr from-pink-600 to-purple-600 rounded-full blur opacity-40 group-hover:opacity-75 transition duration-500"></div>
                    <img src="<%= creator.avatar || '/image/default-avatar.png' %>" 
                         class="relative w-32 h-32 md:w-40 md:h-40 rounded-full object-cover border-4 border-[#0f0f0f]" 
                         alt="<%= creator.username %>">
                </div>

                <div class="flex-1 text-center md:text-left">
                    <div class="flex flex-col md:flex-row md:items-center gap-4 mb-6">
                        <h1 class="text-2xl font-black tracking-tight text-white italic uppercase">
                            @<%= creator.username %>
                            <% if(creator.isVerified) { %>
                                <span class="material-icons-sharp text-blue-500 text-xl align-middle ml-1">verified</span>
                            <% } %>
                        </h1>
                        
<div class="flex gap-2 justify-center flex-wrap">
    <button onclick="subscribeUser('<%= creator._id %>')" id="sub-btn" class="px-8 py-2 <%= creator.isSubbed ? 'bg-gray-700' : 'bg-pink-600 hover:bg-pink-700' %> text-white font-bold rounded-full text-sm transition-all shadow-lg active:scale-95">
        <%= creator.isSubbed ? 'Subscribed' : 'Subscribe' %>
    </button>

    <button onclick="switchTab('messages')" class="p-2 bg-pink-600/10 border border-pink-500/50 hover:bg-pink-600 text-white rounded-full transition-all group">
        <span class="material-icons-sharp text-sm block group-hover:scale-110">message</span>
    </button>

    <button onclick="startVideoCall('<%= creator._id %>')" class="p-2 bg-blue-600/10 border border-blue-500/50 hover:bg-blue-600 text-white rounded-full transition-all group">
        <span class="material-icons-sharp text-sm block group-hover:scale-110">videocam</span>
    </button>

<button id="share-btn" onclick="shareProfile()" class="p-2 bg-gray-800 hover:bg-gray-700 rounded-full transition-all active:scale-90">
    <span class="material-icons-sharp text-sm">share</span>
</button>
</div>
                    </div>

                    <div class="flex justify-center md:justify-start gap-8 mb-6">
                        <div>
                            <p class="text-lg font-black text-white"><%= videos.length %></p>
                            <p class="text-[10px] text-gray-500 uppercase font-bold tracking-widest">Content</p>
                        </div>
                        <div>
                            <p id="sub-count" class="text-lg font-black text-white"><%= creator.subscribersCount || 0 %></p>
                            <p class="text-[10px] text-gray-500 uppercase font-bold tracking-widest">Followers</p>
                        </div>
                    </div>

                    <div class="max-w-md mx-auto md:mx-0">
                        <p class="text-sm text-gray-300 leading-relaxed font-medium">
                            <%= creator.bio || 'No Bio Available 🍿' %>
                        </p>
                    </div>
                </div>
            </div>

            <div class="flex justify-center border-b border-gray-900 mt-4">
                <button onclick="switchTab('videos')" id="tab-videos" class="tab-btn px-8 py-4 text-xs font-black uppercase tracking-widest tab-active">Videos</button>
                <button onclick="switchTab('shorts')" id="tab-shorts" class="tab-btn px-8 py-4 text-xs font-black uppercase tracking-widest text-gray-600 hover:text-gray-400">Shorts</button>
                <button onclick="switchTab('messages')" id="tab-messages" class="tab-btn px-8 py-4 text-xs font-black uppercase tracking-widest text-gray-600 hover:text-gray-400">Messages</button>
            </div>

            <div id="grid-container" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mt-8">
                <% if(videos && videos.length > 0) { %>
                    <% videos.forEach(video => { %>
                        <div class="video-item" data-type="<%= (video.videoType === 'shorts' || video.videoType === 'short') ? 'shorts' : 'videos' %>">
                            <a href="/watch/<%= video._id %>" class="group block bg-[#1a1a1a] rounded-2xl overflow-hidden border border-gray-800/50 hover:border-pink-500/30 transition-all shadow-xl">
                                <div class="relative <%= (video.videoType === 'shorts' || video.videoType === 'short') ? 'aspect-[9/16]' : 'aspect-[16/9]' %> overflow-hidden">
                                    <img src="<%= video.thumbnailUrl %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" alt="thumb">
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-60"></div>
                                </div>
                                <div class="p-3">
                                    <h3 class="text-xs font-bold text-gray-200 truncate group-hover:text-pink-400"><%= video.title %></h3>
                                </div>
                            </a>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div id="no-content-msg" class="col-span-full py-20 text-center">
                        <p class="text-gray-600 font-bold uppercase text-[10px] tracking-widest">No Content Found</p>
                    </div>
                <% } %>
            </div>

            <div id="messages-container" class="hidden mt-8 max-w-2xl mx-auto">
                <div class="bg-[#1a1a1a] border border-gray-800 rounded-3xl p-10 text-center">
                    <span class="material-icons-sharp text-5xl text-pink-600 mb-4">chat_bubble</span>
                    <h2 class="text-xl font-black uppercase italic mb-2">Direct Message</h2>
                    <p class="text-gray-500 text-sm mb-6">Chat directly with @<%= creator.username %></p>
<button onclick="openChat('<%= creator._id %>')" class="px-10 py-3 bg-pink-600 hover:bg-pink-700 rounded-full font-bold text-xs uppercase tracking-widest transition-all shadow-lg shadow-pink-600/20 active:scale-95">
    Open Chat Box
</button>
                    
                </div>
            </div>

        </main>
    </div>

    <%- include('../partials/homeFooter') %>

    <script>
        function switchTab(type) {
            const gridContainer = document.getElementById('grid-container');
            const messagesContainer = document.getElementById('messages-container');
            const videoItems = document.querySelectorAll('.video-item');
            const btns = document.querySelectorAll('.tab-btn');
            
            // UI Update (Tabs)
            btns.forEach(btn => {
                btn.classList.remove('tab-active', 'text-white');
                btn.classList.add('text-gray-600');
            });
            document.getElementById('tab-' + type).classList.add('tab-active');

            if (type === 'messages') {
                // DOM: Hide Grid, Show Messages
                gridContainer.style.display = 'none';
                messagesContainer.classList.remove('hidden');
                messagesContainer.style.display = 'block';
            } else {
                // DOM: Show Grid, Hide Messages
                messagesContainer.style.display = 'none';
                gridContainer.style.display = 'grid';
                
                // Filtering Logic for Videos/Shorts
                videoItems.forEach(item => {
                    item.style.display = (item.getAttribute('data-type') === type) ? 'block' : 'none';
                });
            }
        }

        document.addEventListener('DOMContentLoaded', () => switchTab('videos'));

        async function subscribeUser(userId) {
            try {
                const response = await fetch(`/subscribe/${userId}`, { method: 'POST' });
                const data = await response.json();
                if (data.success) {
                    const btn = document.getElementById('sub-btn');
                    const count = document.getElementById('sub-count');
                    btn.innerText = data.status === 'subscribed' ? 'Subscribed' : 'Subscribe';
                    btn.classList.toggle('bg-pink-600');
                    btn.classList.toggle('bg-gray-700');
                    count.innerText = data.newCount;
                }
            } catch (err) { console.error(err); }
        }

        function startVideoCall(userId) {
            alert("Video Call feature coming soon for " + userId);
        }
    </script>
    <script>
      // Share Profile Function
async function shareProfile() {
    const shareData = {
        title: '<%= creator.username %> | GhapaGhap',
        text: 'Check out @<%= creator.username %> on GhapaGhap! 🍿',
        url: window.location.href // Ye automatically current page ka link le lega
    };

    try {
        // Check agar browser share support karta hai (Mobile browsers mostly do)
        if (navigator.share) {
            await navigator.share(shareData);
        } else {
            // Agar desktop browser hai to link copy kar lega fallback ke liye
            await navigator.clipboard.writeText(window.location.href);
            alert('Link copied to clipboard! 🚀');
        }
    } catch (err) {
        console.error('Error sharing:', err);
    }
}
    </script>
    <script>
      // Function to open direct chat page
function openChat(creatorId) {
    // Agar user logged in nahi hai, toh login page par bhej sakte ho (Optional)
    // window.location.href = `/chat/${creatorId}`;
    
    // Filhaal direct redirection:
    window.location.href = `/chat/${creatorId}`;
}
    </script>
</body>
</html>