<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <title>GhapaGhap | Professional Video Sharing</title>
    <style>
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #0f0f0f; }
        ::-webkit-scrollbar-thumb { background: #333; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #444; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        #mobile-sidebar { transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        #sidebar-overlay { transition: opacity 0.3s ease; }
    </style>
</head>
<body class="bg-[#0f0f0f] text-white font-sans antialiased selection:bg-pink-500/30">

    <div id="sidebar-overlay" class="fixed inset-0 bg-black/70 z-[70] hidden opacity-0 pointer-events-none"></div>

    <aside id="mobile-sidebar" class="fixed top-0 left-0 w-72 h-full bg-[#0f0f0f] z-[80] -translate-x-full border-r border-gray-800 p-5 overflow-y-auto">
        <% if (user) { %> <%- include('../partials/mobWithLogin') %> <% } else { %> <%- include('../partials/mobWithoutLogin') %> <% } %>
    </aside>

    <nav class="fixed top-0 z-50 w-full bg-[#0f0f0f]/90 backdrop-blur-md flex items-center justify-between px-4 h-16 border-b border-gray-800">
        <% if (user) { %> <%- include('../partials/headerWithLogin') %> <% } else { %> <%- include('../partials/headerWithoutLogin') %> <% } %>
    </nav>

    <div class="flex">
        <% if (user) { %> <%- include('../partials/desktopWithLogin') %> <% } else { %> <%- include('../partials/desktopWithoutLogin') %> <% } %>

        <main class="flex-1 w-full lg:ml-64 mt-16 p-4 md:p-8 mb-20">
        <%- include('../partials/topNav') %>

            <div style="margin-top: -2rem;" class="min-h-screen text-white font-sans select-none">
         <div class="flex items-start gap-6 max-w-2xl mx-auto pt-8">
    <div class="relative">
        <img src="<%= user.avatar %>" 
             alt="Profile" 
             class="w-24 h-24 rounded-full border border-gray-800 object-cover" />
    </div>
    <div class="flex-1">
        <div class="flex items-center gap-2 mb-1">
            <h2 class="text-xl font-bold tracking-tight"><%= user.username %></h2>
            <% if(user.isVerified) { %> 
                <i class="fas fa-check-circle text-blue-500 text-sm"></i> 
            <% } %>
        </div>
        <div class="text-sm font-light mb-1 text-gray-200"><%= user.fullname %></div>
        <div class="text-sm font-light text-gray-400">Total Subscribers: <%= user.subscribersCount || 0 %></div>
    </div>
</div>

                <div class="grid grid-cols-2 gap-2 mt-8 max-w-2xl mx-auto">
                    <div class="bg-[#262626] hover:bg-[#363636] transition-colors py-1.5 rounded-lg text-sm font-semibold flex justify-center">
                        <a href="/editProfile"><button class="" >Edit profile</button></a>
                    </div>

                     <div class="bg-[#262626] hover:bg-[#363636] transition-colors py-1.5 rounded-lg text-sm font-semibold flex justify-center">
                        <a href="/changePassword"><button class="" >Change Password</button></a>
                    </div>
                    
                </div>

                <div class="grid grid-cols-1 gap-2 mt-2 max-w-2xl mx-auto">
                    <% if(!user.isVerified) { %>
                        <button id="verifyBtn" class="bg-red-400 hover:bg-blue-400 transition-colors py-1.5 rounded-lg text-sm font-semibold">Verify your Account</button>
                    <% } else { %>
                        <button class="hidden bg-green-600 py-1.5 rounded-lg text-sm font-semibold cursor-default">Account Verified</button>
                    <% } %>

                    <div id="cameraModal" class="hidden fixed inset-0 bg-black/95 z-[100] flex flex-col items-center justify-center p-4">
                        <video id="video" autoplay playsinline class="w-full max-w-md rounded-xl border-2 border-white shadow-2xl"></video>
                        <canvas id="canvas" class="hidden"></canvas>
                        <div class="flex gap-4 mt-8">
                            <button id="captureBtn" class="bg-green-500 hover:bg-green-600 text-white px-8 py-3 rounded-full font-bold transition-transform active:scale-95">Capture & Verify</button>
                            <button id="closeBtn" class="bg-gray-600 hover:bg-gray-700 text-white px-8 py-3 rounded-full font-bold">Cancel</button>
                        </div>
                    </div>

                    <% if (user && user.isVerified) { %>
                        <div class="bg-[#262626] hover:bg-green-700 transition-colors py-1.5 rounded-lg text-sm font-semibold px-4 flex justify-center">
                        <a href="/addBankAccount"><button class="" >Add Bank Account</button></a>
                    </div>
                    <% } else { %>
                         <div class="text-xs text-yellow-500 bg-yellow-500/10 p-2 rounded-lg border border-yellow-500/20">
                         Verification pending... Bank account add karne ke liye verify karein.
                        </div>
                    <% } %>
                    <div class="bg-[#262626] hover:bg-green-700 transition-colors py-1.5 rounded-lg text-sm font-semibold px-4 flex justify-center">
                        <a href="/packs"><button class="" >Add Subscription Pack</button></a>
                    </div>

                </div>

                <div class="grid grid-cols-2 gap-2 mt-2 max-w-2xl mx-auto">
                </div>

<div class="flex items-center justify-around mt-8 max-w-2xl mx-auto gap-4">
    <% if (typeof user !== 'undefined' && user.isVerified) { %>
        <div onclick="showContent('shorts')" id="tab-shorts" 
             class="flex-1 text-center border border-pink-500/30 rounded-2xl p-6 text-white cursor-pointer transition-all hover:border-pink-500/50 active:scale-95 group bg-pink-500/5">
            <span class="block text-gray-500 text-xs uppercase tracking-widest mb-1 group-hover:text-pink-400">Total Shorts</span>
            <span class="text-3xl font-black text-pink-500"><%= (typeof shorts !== 'undefined') ? shorts.length : 0 %></span>
        </div>

        <div onclick="showContent('videos')" id="tab-videos" 
             class="flex-1 text-center border border-zinc-800 rounded-2xl p-6 text-white cursor-pointer transition-all hover:border-blue-500/50 active:scale-95 group bg-zinc-900/30">
            <span class="block text-gray-500 text-xs uppercase tracking-widest mb-1 group-hover:text-blue-400">Total Videos</span>
            <span class="text-3xl font-black text-blue-500"><%= (typeof videos !== 'undefined') ? videos.length : 0 %></span>
        </div>
    <% } %>
</div>

<div id="content-shorts" class="w-full max-w-6xl mx-auto mt-8 px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4">
        <% if (typeof shorts !== 'undefined' && shorts.length > 0) { %>
            <% shorts.forEach(short => { %>
                <div class="aspect-[9/16] bg-zinc-900 rounded-xl overflow-hidden border border-white/5 group relative">
                    <img src="<%= short.thumbnailUrl %>" class="w-full h-full object-cover" loading="lazy">
                    
                    <a href="/shorts/<%= short._id %>" class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                        <div class="p-4 bg-pink-600 rounded-full scale-75 group-hover:scale-100 transition-transform">
                            <i class="fas fa-play text-white text-xl"></i>
                        </div>
                    </a>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-span-full text-center py-10">
                <p class="text-gray-600 italic font-medium">No shorts uploaded yet.</p>
            </div>
        <% } %>
    </div>
</div>

<div id="content-videos" class="hidden w-full max-w-6xl mx-auto mt-8 px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% if (typeof videos !== 'undefined' && videos.length > 0) { %>
            <% videos.forEach(video => { %>
                <div class="bg-zinc-900/50 rounded-2xl overflow-hidden border border-white/5 group transition-all hover:border-blue-500/30 relative">
                    <a href="/watch/<%= video._id %>" class="block">
                        <div class="aspect-video relative">
                            <img src="<%= video.thumbnailUrl %>" class="w-full h-full object-cover" loading="lazy">
                            <span class="absolute bottom-2 right-2 bg-black/80 px-2 py-0.5 text-[10px] rounded text-white font-bold"><%= video.duration %></span>
                            <div class="absolute inset-0 flex items-center justify-center bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity">
                                <i class="fas fa-play text-white text-2xl"></i>
                            </div>
                        </div>
                    </a>
                    
                    <div class="p-4">
                        <a href="/watch/<%= video._id %>">
                            <h4 class="font-bold text-sm truncate text-white hover:text-blue-400 transition-colors"><%= video.title %></h4>
                        </a>
                        <div class="flex items-center justify-between mt-3 text-xs text-gray-500">
                            <span><i class="fas fa-eye mr-1"></i> <%= video.views || 0 %> views</span>
                            <div class="flex gap-3">
                                <a href="/my-videos/edit/<%= video._id %>" class="text-blue-500 hover:text-blue-300 font-medium">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button class="text-red-500/70 hover:text-red-500"><i class="fas fa-trash-can"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-span-full text-center py-10">
                <p class="text-gray-600 italic font-medium">No videos uploaded yet.</p>
            </div>
        <% } %>
    </div>
</div>

<script>
function showContent(type) {
    const shortsTab = document.getElementById('tab-shorts');
    const videosTab = document.getElementById('tab-videos');
    const shortsContent = document.getElementById('content-shorts');
    const videosContent = document.getElementById('content-videos');

    if (type === 'shorts') {
        shortsContent.classList.remove('hidden');
        videosContent.classList.add('hidden');
        // UI Colors for Shorts (Pink)
        shortsTab.classList.add('bg-pink-500/5', 'border-pink-500/30');
        shortsTab.classList.remove('bg-zinc-900/30', 'border-zinc-800');
        // Reset Video Tab
        videosTab.classList.add('bg-zinc-900/30', 'border-zinc-800');
        videosTab.classList.remove('bg-blue-500/5', 'border-blue-500/30');
    } else {
        videosContent.classList.remove('hidden');
        shortsContent.classList.add('hidden');
        // UI Colors for Videos (Blue)
        videosTab.classList.add('bg-blue-500/5', 'border-blue-500/30');
        videosTab.classList.remove('bg-zinc-900/30', 'border-zinc-800');
        // Reset Shorts Tab
        shortsTab.classList.add('bg-zinc-900/30', 'border-zinc-800');
        shortsTab.classList.remove('bg-pink-500/5', 'border-pink-500/30');
    }
}
</script>
            </div>
        </main>
    </div>

    <%- include('../partials/profileFooter') %>
    <%- include('../partials/popupAd') %>

    <script src="js/sidebar.js"></script>
    <script src="js/dom.js"></script>

    <script>
        
        const verifyBtn = document.getElementById('verifyBtn');
        const cameraModal = document.getElementById('cameraModal');
        const video = document.getElementById('video');
        const canvas = document.getElementById('canvas');
        const captureBtn = document.getElementById('captureBtn');
        const closeBtn = document.getElementById('closeBtn');
        let stream = null;

        // Camera functions
        function stopCamera() {
            if (stream) stream.getTracks().forEach(track => track.stop());
            cameraModal.classList.add('hidden');
            captureBtn.disabled = false;
            captureBtn.innerText = "Capture & Verify";
        }

        if(verifyBtn) {
            verifyBtn.addEventListener('click', async () => {
                try {
                    stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "user" } });
                    video.srcObject = stream;
                    cameraModal.classList.remove('hidden');
                } catch (err) {
                    alert("Camera access denied! Please check permissions.");
                }
            });
        }

        closeBtn.addEventListener('click', stopCamera);

        captureBtn.addEventListener('click', async () => {
            const context = canvas.getContext('2d');
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            context.drawImage(video, 0, 0, canvas.width, canvas.height);
            
            const imageData = canvas.toDataURL('image/jpeg');
            captureBtn.innerText = "Verifying...";
            captureBtn.disabled = true;

            try {
                const response = await fetch('/verify/live-capture', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ image: imageData })
                });

                const result = await response.json();
                if (result.success) {
                    alert(result.message);
                    window.location.reload();
                } else {
                    alert("Error: " + result.message);
                    stopCamera();
                }
            } catch (err) {
                console.error(err);
                alert("Server connection failed!");
                stopCamera();
            }
        });

        // Tab switching logic
        function showContent(type) {
            document.getElementById('content-shorts').classList.add('hidden');
            document.getElementById('content-videos').classList.add('hidden');
            document.getElementById(`content-${type}`).classList.remove('hidden');
        }



        
    </script>
</body>
</html>