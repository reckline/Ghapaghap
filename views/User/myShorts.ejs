<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <title>My Shorts | GhapaGhap</title>
</head>
<body class="bg-[#0f0f0f] text-white">

    <nav class="fixed top-0 z-50 w-full bg-[#0f0f0f]/90 backdrop-blur-md h-16 border-b border-gray-800">
        <% if (locals.user) { %> 
            <%- include('../partials/headerWithLogin') %> 
        <% } else { %> 
            <%- include('../partials/headerWithoutLogin') %> 
        <% } %>
    </nav>

    <div class="flex">
        <% if (locals.user) { %>
            <%- include('../partials/desktopWithLogin') %>
        <% } else { %>
            <%- include('../partials/desktopWithoutLogin') %>
        <% } %>

        <main class="flex-1 lg:ml-64 mt-16 p-6">
            <div class="max-w-6xl mx-auto">
                <div class="flex items-center justify-between mb-8">
                    <div>
                        <h1 class="text-2xl font-bold flex items-center gap-3">
                            <i class="fas fa-bolt-lightning text-pink-500"></i>
                            My Shorts
                        </h1>
                        <p class="text-gray-400 text-sm mt-1">Manage your uploaded short videos</p>
                    </div>
                    <a href="/upload-video" class="bg-pink-600 hover:bg-pink-700 px-5 py-2 rounded-full text-sm font-bold transition-all shadow-lg shadow-pink-600/20">
                        + Upload New
                    </a>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
                    <% if (typeof shorts !== 'undefined' && shorts.length > 0) { %>
                        <% shorts.forEach(short => { %>
                            <div class="relative aspect-[9/16] bg-zinc-900 rounded-xl overflow-hidden group border border-gray-800 hover:border-pink-500/50 transition-all">
                                <img src="<%= short.thumbnailUrl %>" class="w-full h-full object-cover" alt="Short" onerror="this.src='https://picsum.photos/seed/shorts/400/700'">
                                
                                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity p-3 flex flex-col justify-end">
                                    <p class="text-xs font-bold truncate mb-2 text-white"><%= short.title %></p>
                                    
                                    <div class="flex gap-2">
                                        <a href="/shorts/<%= short._id %>" class="flex-1 text-center text-[10px] bg-white text-black py-1.5 rounded font-bold hover:bg-pink-500 hover:text-white transition-colors">
                                            View
                                        </a>
                                        <a href="/my-videos/edit/<%= short._id %>" class="flex-1 text-center text-[10px] bg-zinc-800 text-white py-1.5 rounded font-bold hover:bg-blue-600 transition-colors">
                                            Edit
                                        </a>
                                    </div>
                                    <button onclick="deleteVideo('<%= short._id %>')" class="mt-2 w-full text-[10px] bg-red-600/20 text-red-500 py-1.5 rounded font-bold hover:bg-red-600 hover:text-white transition-all">
                                        Delete
                                    </button>
                                </div>

                                <div class="absolute top-2 left-2 bg-black/60 backdrop-blur-md px-2 py-0.5 rounded text-[10px] font-bold">
                                    <i class="fas fa-eye text-pink-500 mr-1"></i> <%= short.views || 0 %>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="col-span-full py-24 text-center">
                            <div class="w-20 h-20 bg-zinc-900 rounded-full flex items-center justify-center mx-auto mb-4 border border-gray-800 shadow-inner">
                                <i class="fas fa-bolt-lightning text-3xl text-zinc-700"></i>
                            </div>
                            <h3 class="text-lg font-bold text-zinc-300">No Shorts Found</h3>
                            <p class="text-gray-500 text-sm mt-1">Aapne abhi tak koi shorts upload nahi kiya hai.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </main>
    </div>

    <script>
        async function deleteVideo(id) {
            if(confirm('Kya aap is short ko delete karna chahte hain?')) {
                try {
                    const res = await fetch(`/my-videos/delete/${id}`, { method: 'DELETE' });
                    if(res.ok) window.location.reload();
                    else alert('Delete karne mein kuch dikkat aayi.');
                } catch (err) {
                    console.error(err);
                }
            }
        }
    </script>
</body>
</html>