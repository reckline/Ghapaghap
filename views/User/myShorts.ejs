<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %> <title>My Shorts | GhapaGhap</title>
</head>
<body class="bg-[#0f0f0f] text-white">

    <nav class="fixed top-0 z-50 w-full bg-[#0f0f0f]/90 backdrop-blur-md h-16 border-b border-gray-800">
        <% if (user) { %> <%- include('../partials/headerWithLogin') %> <% } else { %> <%- include('../partials/headerWithoutLogin') %> <% } %>
    </nav>

    <div class="flex">
        <%- include('../partials/desktopWithLogin') %>

        <main class="flex-1 lg:ml-64 mt-16 p-6">
            <div class="max-w-6xl mx-auto">
                <div class="flex items-center justify-between mb-8">
                    <div>
                        <h1 class="text-2xl font-bold flex items-center gap-3">
                            <i class="fas fa-bolt-lightning text-pink-500"></i>
                            My Shorts
                        </h1>
                        <p class="text-gray-400 text-sm mt-1">Manage your uploaded short videos</p>
                    </div>
                    <a href="/upload" class="bg-pink-600 hover:bg-pink-700 px-5 py-2 rounded-full text-sm font-bold transition-all">
                        + Upload New
                    </a>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
                    <% if (shorts && shorts.length > 0) { %>
                        <% shorts.forEach(short => { %>
                            <div class="relative aspect-[9/16] bg-zinc-900 rounded-xl overflow-hidden group border border-gray-800">
                                <img src="<%= short.thumbnail %>" class="w-full h-full object-cover" alt="Short">
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity p-3 flex flex-col justify-end">
                                    <p class="text-xs font-medium truncate"><%= short.title %></p>
                                    <div class="flex gap-2 mt-2">
                                        <button class="text-[10px] bg-white/10 p-1 px-2 rounded hover:bg-pink-600">Edit</button>
                                        <button class="text-[10px] bg-red-600/20 text-red-500 p-1 px-2 rounded hover:bg-red-600 hover:text-white">Delete</button>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="col-span-full py-20 text-center">
                            <div class="w-20 h-20 bg-zinc-900 rounded-full flex items-center justify-center mx-auto mb-4 border border-gray-800">
                                <i class="fas fa-bolt-lightning text-3xl text-gray-700"></i>
                            </div>
                            <h3 class="text-lg font-bold">No Shorts Found</h3>
                            <p class="text-gray-500 text-sm">Aapne abhi tak koi shorts upload nahi kiya hai.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </main>
    </div>

</body>
</html>