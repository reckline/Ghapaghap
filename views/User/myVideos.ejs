<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <title><%= title %></title>
    <style>
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: #0f0f0f; }
        ::-webkit-scrollbar-thumb { background: #333; border-radius: 10px; }
        #mobile-sidebar { transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        
        /* Smooth hover effect for cards */
        .video-card { transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
        .video-card:hover { transform: translateY(-8px); }
    </style>
</head>
<body class="bg-[#0f0f0f] text-white font-sans antialiased selection:bg-pink-500/30 overflow-hidden">

    <div id="sidebar-overlay" class="fixed inset-0 bg-black/70 z-[70] hidden opacity-0 transition-opacity duration-300"></div>

    <aside id="mobile-sidebar" class="fixed top-0 left-0 w-72 h-full bg-[#0f0f0f] z-[80] -translate-x-full border-r border-gray-800 p-5 overflow-y-auto">
        <% if (user) { %>
            <%- include('../partials/mobWithLogin') %>
        <% } else { %>
            <%- include('../partials/mobWithoutLogin') %>
        <% } %>
    </aside>

    <nav class="fixed top-0 z-50 w-full bg-[#0f0f0f]/95 backdrop-blur-xl flex items-center justify-between px-4 md:px-8 h-16 border-b border-gray-800">
        <% if (user) { %>
            <%- include('../partials/headerWithLogin') %>
        <% } else { %>
            <%- include('../partials/headerWithoutLogin') %>
        <% } %>
    </nav>

    <div class="flex pt-16 h-screen overflow-hidden">
        
        <div class="hidden md:block w-64 border-r border-gray-800 h-full overflow-y-auto bg-[#0f0f0f]">
            <% if (user) { %>
                <%- include('../partials/desktopWithLogin') %>
            <% } else { %>
                <%- include('../partials/desktopWithoutLogin') %>
            <% } %>
        </div>

        <main class="flex-1 overflow-y-auto p-4 sm:p-6 md:p-10 custom-scrollbar bg-[#0b0b0b]">
            <div class="max-w-[1600px] mx-auto">
                
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 mb-12">
                    <div>
                        <h1 class="text-3xl md:text-4xl font-black text-white tracking-tighter uppercase italic flex items-center gap-3">
                            My <span class="text-pink-600 drop-shadow-[0_0_15px_rgba(219,39,119,0.4)]">Videos</span>
                        </h1>
                        <div class="flex items-center gap-2 mt-2">
                            <span class="h-1 w-8 bg-pink-600 rounded-full"></span>
                            <p class="text-[11px] text-zinc-500 font-bold uppercase tracking-[0.2em]">Manage Content library</p>
                        </div>
                    </div>
                    
                    <a href="/upload-video" class="group relative px-8 py-3 bg-white text-black font-black text-xs uppercase rounded-2xl transition-all hover:bg-pink-600 hover:text-white flex items-center gap-3">
                        <i class="fas fa-cloud-arrow-up transition-transform group-hover:-translate-y-1"></i>
                        Upload New
                    </a>
                </div>

                <% if(videos && videos.length > 0) { %>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-6 xl:gap-8">
                        <% videos.forEach(video => { %>
                            <div id="video-card-<%= video._id %>" class="video-card bg-zinc-900/30 border border-white/5 rounded-[2.5rem] overflow-hidden group hover:border-pink-600/40 hover:bg-zinc-900/60">
                                
                                <div class="relative aspect-video bg-zinc-800 overflow-hidden">
                                    <img src="<%= video.thumbnailUrl || '/images/default-thumb.jpg' %>" alt="" class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-110 transition-transform duration-700">
                                    
                                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity">
                                        <div class="w-12 h-12 bg-pink-600 rounded-full flex items-center justify-center text-white scale-75 group-hover:scale-100 transition-transform">
                                            <i class="fas fa-play"></i>
                                        </div>
                                    </div>

                                    <div class="absolute bottom-4 right-4 bg-black/90 backdrop-blur-md px-2.5 py-1 rounded-lg text-[10px] font-black text-white">
                                        <%= video.duration || '0:00' %>
                                    </div>
                                </div>

                                <div class="p-6">
                                    <h3 class="text-white font-bold text-[15px] line-clamp-1 mb-2 group-hover:text-pink-500 transition-colors"><%= video.title %></h3>
                                    
                                    <div class="flex items-center justify-between text-[10px] text-zinc-500 font-bold uppercase tracking-tighter mb-5">
                                        <span class="flex items-center gap-1.5"><i class="fas fa-fire-alt text-orange-500"></i> <%= video.views %> Views</span>
                                        <span class="flex items-center gap-1.5"><i class="far fa-calendar"></i> <%= new Date(video.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }) %></span>
                                    </div>

                                    <div class="flex gap-3">
                                        <a href="/my-videos/edit/<%= video._id %>" class="flex-1 bg-white/[0.03] hover:bg-white text-white hover:text-black border border-white/10 text-center py-3 rounded-2xl text-[10px] font-black uppercase transition-all">
                                            Edit Info
                                        </a>
                                        <button onclick="deleteVideo('<%= video._id %>')" class="w-12 bg-red-500/10 hover:bg-red-600 text-red-500 hover:text-white py-3 rounded-2xl text-xs transition-all border border-red-500/20">
                                            <i class="fas fa-trash-can"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="flex flex-col items-center justify-center py-40 border-2 border-dashed border-white/5 rounded-[4rem] bg-zinc-900/10">
                        <div class="relative mb-6">
                            <div class="absolute inset-0 bg-pink-600 blur-3xl opacity-10 animate-pulse"></div>
                            <i class="fas fa-clapperboard text-6xl text-zinc-800 relative"></i>
                        </div>
                        <h2 class="text-xl font-bold text-zinc-400 mb-2">No videos yet, Bhai!</h2>
                        <p class="text-[10px] font-black uppercase tracking-[0.4em] text-zinc-600 mb-8">Ready to start your journey?</p>
                        <a href="/upload-video" class="px-10 py-4 bg-pink-600 text-white rounded-full font-black text-xs uppercase hover:scale-110 transition-transform">Upload Your First Video</a>
                    </div>
                <% } %>

            </div>
        </main>
    </div>
<%- include('../partials/homeFooter') %>
    <script>
        // Sidebar Mobile Toggle
        const sidebar = document.getElementById("mobile-sidebar");
        const overlay = document.getElementById("sidebar-overlay");

        function toggleSidebar() {
            const isClosed = sidebar.classList.contains("-translate-x-full");
            if (isClosed) {
                sidebar.classList.remove("-translate-x-full");
                overlay.classList.remove("hidden");
                setTimeout(() => overlay.classList.add("opacity-100"), 10);
            } else {
                sidebar.classList.add("-translate-x-full");
                overlay.classList.remove("opacity-100");
                setTimeout(() => overlay.classList.add("hidden"), 300);
            }
        }
        overlay.addEventListener("click", toggleSidebar);

        // AJAX Delete with Sweet Animations
        async function deleteVideo(id) {
            if (confirm('Bhai, pakka delete karna hai? Ye wapas nahi aayega!')) {
                const card = document.getElementById(`video-card-${id}`);
                try {
                    const response = await fetch(`/my-videos/delete/${id}`, {
                        method: 'DELETE'
                    });
                    
                    const data = await response.json();
                    
                    if (data.success) {
                        card.style.transform = 'scale(0.5) translateY(50px)';
                        card.style.opacity = '0';
                        setTimeout(() => {
                            card.remove();
                            if (document.querySelectorAll('[id^="video-card-"]').length === 0) {
                                window.location.reload();
                            }
                        }, 400);
                    } else {
                        alert('Error: ' + data.message);
                    }
                } catch (err) {
                    alert('Server error! Check connection.');
                }
            }
        }
    </script>
</body>
</html>