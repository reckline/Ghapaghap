<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>404 - Page Not Found</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white flex items-center justify-center h-screen">
    <div class="text-center">
        <h1 class="text-900 text-6xl font-bold text-red-500">404</h1>
        <p class="text-2xl mt-4 text-gray-400 font-semibold">Bhai, ye rasta galat hai!</p>
        <p class="mt-2 text-gray-500 italic uppercase">Path: <%= message %></p>
        <a href="/login" class="mt-6 inline-block bg-blue-600 hover:bg-blue-700 px-6 py-2 rounded-lg transition">Wapas Login par Chalo</a>
    </div>
</body>
</html>