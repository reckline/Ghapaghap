    <div id="camera-modal" class="fixed inset-0 z-[100] bg-black hidden flex flex-col items-center justify-center">
        <video id="webcam" autoplay playsinline class="w-full h-full object-cover"></video>
        <div class="absolute bottom-10 flex gap-10 items-center">
            <button onclick="closeCamera()" class="w-14 h-14 bg-white/10 rounded-full flex items-center justify-center backdrop-blur-md"><span class="material-icons-sharp">close</span></button>
            <button onclick="takeSnap()" class="w-20 h-20 bg-white rounded-full p-1"><div class="w-full h-full rounded-full border-4 border-black/20"></div></button>
        </div>
        <canvas id="canvas" class="hidden"></canvas>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        const chatBox = document.getElementById('chat-box');
        const msgForm = document.getElementById('msg-form');
        const userInput = document.getElementById('user-input');
        const sendBtn = document.getElementById('send-btn');
        const micBtn = document.getElementById('mic-btn');
        const currentUserId = "<%= user._id %>"; 
        const receiverId = "<%= receiverId %>";

        let selectedMediaBlob = null;
        let mediaType = 'text';
        let mediaRecorder, audioChunks = [];
        let startTime, timerInterval;

        socket.emit('join-chat', currentUserId);
        window.onload = () => { chatBox.scrollTop = chatBox.scrollHeight; userInput.focus(); };

        function showPreview(name, icon = 'attachment') { 
            document.getElementById('media-preview').classList.remove('hidden'); 
            document.getElementById('preview-name').innerHTML = `<span class="material-icons-sharp text-sm">${icon}</span> ${name}`; 
        }

        function clearPreview() { 
            selectedMediaBlob = null; 
            mediaType = 'text'; 
            document.getElementById('media-preview').classList.add('hidden'); 
            document.getElementById('file-input').value = ''; 
        }

        function handleFile(input) { 
            if(input.files[0]) { 
                selectedMediaBlob = input.files[0]; 
                mediaType = 'image'; 
                showPreview(input.files[0].name, 'image'); 
            } 
        }

        async function openCamera() {
            try {
                document.getElementById('camera-modal').classList.remove('hidden');
                const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "user" } });
                document.getElementById('webcam').srcObject = stream;
            } catch(e) { alert("Camera Error"); }
        }

        function closeCamera() {
            const stream = document.getElementById('webcam').srcObject;
            if(stream) stream.getTracks().forEach(t => t.stop());
            document.getElementById('camera-modal').classList.add('hidden');
        }

        function takeSnap() {
            const video = document.getElementById('webcam');
            const canvas = document.getElementById('canvas');
            canvas.width = video.videoWidth; 
            canvas.height = video.videoHeight;
            canvas.getContext('2d').drawImage(video, 0, 0);
            canvas.toBlob(blob => {
                selectedMediaBlob = new File([blob], `snap_${Date.now()}.jpg`, { type: 'image/jpeg' });
                mediaType = 'image';
                showPreview("Snap Captured", 'photo_camera');
                closeCamera();
            }, 'image/jpeg');
        }

        async function startRecording() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                mediaRecorder = new MediaRecorder(stream);
                audioChunks = [];
                
                document.getElementById('recording-overlay').classList.remove('hidden');
                micBtn.classList.add('recording-pulse');
                
                startTime = Date.now();
                timerInterval = setInterval(() => {
                    const sec = Math.floor((Date.now() - startTime) / 1000);
                    document.getElementById('record-timer').innerText = `00:${sec.toString().padStart(2, '0')}`;
                }, 1000);

                mediaRecorder.ondataavailable = e => audioChunks.push(e.data);
                mediaRecorder.onstop = () => {
                    const audioBlob = new Blob(audioChunks, { type: 'audio/mpeg' });
                    selectedMediaBlob = new File([audioBlob], `voice_${Date.now()}.mp3`, { type: 'audio/mpeg' });
                    mediaType = 'audio';
                    showPreview("Voice Note Ready", 'mic');
                    
                    document.getElementById('recording-overlay').classList.add('hidden');
                    micBtn.classList.remove('recording-pulse');
                    clearInterval(timerInterval);
                };
                mediaRecorder.start();
            } catch(e) { console.error("Mic error"); }
        }

        function stopRecording() { 
            if(mediaRecorder && mediaRecorder.state !== 'inactive') {
                mediaRecorder.stop();
                mediaRecorder.stream.getTracks().forEach(t => t.stop());
            } 
        }

        msgForm.onsubmit = async (e) => {
            e.preventDefault();
            const message = userInput.value.trim();
            if(!message && !selectedMediaBlob) return;

            sendBtn.disabled = true;
            let finalMediaUrl = null;

            try {
                if(selectedMediaBlob) {
                    const formData = new FormData();
                    // Field name 'media' matches chatController requirements
                    formData.append('media', selectedMediaBlob);
                    
                    const res = await fetch('/upload-media', { method: 'POST', body: formData });
                    const data = await res.json();
                    
                    if(data.success) {
                        finalMediaUrl = data.url;
                        // Use mediaType from PHP if available for precision
                        if(data.mediaType) mediaType = data.mediaType;
                    } else {
                        throw new Error(data.message || "Upload Failed");
                    }
                }

                const msgData = {
                    senderId: currentUserId, 
                    receiverId: receiverId,
                    message, 
                    media: finalMediaUrl, 
                    mediaType: mediaType
                };

                socket.emit('send-private-message', msgData);
                appendMessage(message, 'sent', '', finalMediaUrl, mediaType);
                
                userInput.value = ''; 
                clearPreview();
            } catch (err) { 
                alert("Error: " + err.message);
            } finally { 
                sendBtn.disabled = false; 
            }
        };

        socket.on('receive-private-message', (data) => {
            if(data.senderId === receiverId) {
                appendMessage(data.message, 'received', data.timestamp, data.media, data.mediaType);
            }
        });

        function appendMessage(text, type, time = '', media = null, mType = 'text') {
            const isSent = type === 'sent';
            const now = time || new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            let mediaHtml = '';
            
            if(media) {
                if(mType === 'image') mediaHtml = `<img src="${media}" class="w-full rounded-lg mb-2 border border-white/10">`;
                else if(mType === 'audio') mediaHtml = `<audio controls class="w-full h-10 mb-2 filter brightness-125"><source src="${media}" type="audio/mpeg"></audio>`;
            }

            const msgHtml = `
                <div class="flex ${isSent ? 'justify-end' : 'justify-start'} animate-msg">
                    <div class="max-w-[80%] ${isSent ? 'msg-sent' : 'msg-received'} p-3 shadow-xl">
                        ${mediaHtml}
                        ${text ? `<p class="text-sm">${text}</p>` : ''}
                        <p class="text-[9px] opacity-60 mt-1 text-right">${now}</p>
                    </div>
                </div>`;
            
            chatBox.insertAdjacentHTML('beforeend', msgHtml);
            chatBox.scrollTop = chatBox.scrollHeight;
        }
    </script>
</body>
</html>