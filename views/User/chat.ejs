<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Sharp" rel="stylesheet">
    <title>Chat | GhapaGhap</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: #080808; color: white; }
        .glass { background: rgba(15, 15, 15, 0.8); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
        ::-webkit-scrollbar { width: 3px; }
        ::-webkit-scrollbar-thumb { background: #db2777; border-radius: 10px; }
        .msg-sent { background: linear-gradient(135deg, #db2777 0%, #9d174d 100%); border-radius: 18px 18px 4px 18px; }
        .msg-received { background: #1f1f1f; border-radius: 18px 18px 18px 4px; border: 1px solid rgba(255,255,255,0.05); }
        .animate-msg { animation: messageIn 0.3s ease forwards; }
        @keyframes messageIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .recording-pulse { animation: pulse 1.5s infinite; color: #ef4444 !important; }
        @keyframes pulse { 0% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(1.1); } 100% { opacity: 1; transform: scale(1); } }
        audio::-webkit-media-controls-panel { background-color: #db2777; }
    </style>
</head>
<body class="overflow-hidden h-screen flex flex-col overflow-hidden">

<nav class="fixed top-0 w-full h-16 border-b border-white/5 glass z-50 flex items-center justify-between px-4 shrink-0">
        <div class="flex items-center gap-3">
            <button onclick="history.back()" class="p-2 hover:bg-white/5 rounded-full"><span class="material-icons-sharp text-gray-400">arrow_back_ios_new</span></button>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-pink-500 to-purple-600 p-[1.5px]">
                    <div class="w-full h-full rounded-full bg-black overflow-hidden">
                        <% 
                            let dp = 'https://cdn-icons-png.flaticon.com/512/149/149071.png';
                            if (receiver && receiver.profileImage) {
                                dp = receiver.profileImage.startsWith('http') ? receiver.profileImage : '/uploads/' + receiver.profileImage;
                            } else if (receiver && receiver.avatar) {
                                dp = receiver.avatar;
                            }
                        %>
                        <img src="<%= dp %>" class="w-full h-full object-cover" onerror="this.src='https://cdn-icons-png.flaticon.com/512/149/149071.png'">
                    </div>
                </div>
                <div>
                    <h2 class="text-sm font-bold"><%= receiver ? receiver.username : 'User' %></h2>
                    <span class="text-[10px] text-green-500 font-bold uppercase tracking-widest">● Online</span>
                </div>
            </div>
        </div>
    </nav>

    <main id="chat-box" class="h-screen pt-20 pb-32 overflow-y-auto px-4 flex flex-col gap-4 flex-1 overflow-y-auto">
        <% if (messages && messages.length > 0) { %>
            <% messages.forEach(msg => { %>
                <% const isSent = msg.sender.toString() === user._id.toString(); %>
                <div class="flex <%= isSent ? 'justify-end' : 'justify-start' %> animate-msg">
                    <div class="max-w-[80%] <%= isSent ? 'msg-sent' : 'msg-received' %> p-3 shadow-xl">
                        <% if(msg.media && msg.mediaType === 'image') { %>
                            <img src="<%= msg.media %>" class="w-full rounded-lg mb-2 border border-white/10">
                        <% } %>
                        <% if(msg.media && msg.mediaType === 'audio') { %>
                            <audio controls class="w-[10rem] h-10 mb-2 filter brightness-125">
                                <source src="<%= msg.media %>" type="audio/mpeg">
                            </audio>
                        <% } %>
                        <% if(msg.message) { %><p class="text-sm"><%= msg.message %></p><% } %>
                        <p class="text-[9px] opacity-60 mt-1 text-right"><%= new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></p>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </main>

    <footer class="shrink-0 w-full p-2 md:p-4 glass border-t border-white/5 z-50 safe-area-bottom">
    
    <div id="recording-overlay" class="hidden max-w-4xl mx-auto mb-2 p-2 md:p-3 bg-red-500/10 border border-red-500/20 rounded-2xl flex items-center justify-between">
        <div class="flex items-center gap-2 md:gap-3">
            <span class="relative flex h-2 w-2 md:h-3 md:w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 md:h-3 md:w-3 bg-red-500"></span>
            </span>
            <span class="text-[10px] md:text-xs font-bold text-red-500 uppercase tracking-widest">Recording...</span>
        </div>
        <span id="record-timer" class="text-xs font-mono text-red-500">00:00</span>
    </div>

    <div id="media-preview" class="hidden max-w-2xl mx-auto mb-2 p-2 bg-pink-500/10 border border-pink-500/20 rounded-xl flex items-center justify-between">
        <span id="preview-name" class="text-[10px] md:text-xs text-pink-200 truncate pr-4 flex items-center gap-2"></span>
        <button onclick="clearPreview()" class="text-pink-500 shrink-0"><span class="material-icons-sharp text-sm">close</span></button>
    </div>

    <form id="msg-form" class="max-w-4xl mx-auto flex items-center gap-1 md:gap-2">
        
        <div class="relative group">
            <button type="button" class="p-2 text-gray-400 hover:text-pink-500 transition-colors">
                <span class="material-icons-sharp text-2xl md:text-3xl">add_circle</span>
            </button>
            <div class="absolute bottom-14 left-0 bg-[#1a1a1a] border border-white/10 rounded-2xl p-1.5 hidden group-hover:flex flex-col gap-1 shadow-2xl z-50">
                <button type="button" onclick="document.getElementById('file-input').click()" class="p-3 hover:bg-white/5 rounded-xl text-blue-400 flex items-center justify-center">
                    <span class="material-icons-sharp">image</span>
                </button>
                <button type="button" onclick="openCamera()" class="p-3 hover:bg-white/5 rounded-xl text-pink-500 flex items-center justify-center">
                    <span class="material-icons-sharp">photo_camera</span>
                </button>
            </div>
        </div>

        <input type="file" id="file-input" class="hidden" accept="image/*" onchange="handleFile(this)">
        
        <input type="text" id="user-input" autocomplete="off" placeholder="Message..." 
               class="flex-1 min-w-0 bg-white/5 border border-white/10 rounded-full px-4 md:px-5 py-2.5 md:py-3 text-[14px] md:text-base focus:outline-none focus:border-pink-500/50 transition-all">
        
        <button type="button" 
                onmousedown="startRecording()" onmouseup="stopRecording()" 
                onmouseleave="stopRecording()" ontouchstart="startRecording()" ontouchend="stopRecording()"
                id="mic-btn" class="p-2 text-gray-400 hover:text-red-500 active:scale-125 transition-all shrink-0">
            <span class="material-icons-sharp text-2xl md:text-3xl">mic</span>
        </button>

        <button type="submit" id="send-btn" 
                class="w-10 h-10 md:w-12 md:h-12 bg-pink-600 rounded-full flex items-center justify-center hover:bg-pink-700 shadow-lg shadow-pink-600/20 active:scale-90 transition-all shrink-0">
            <span class="material-icons-sharp text-white text-xl md:text-2xl">send</span>
        </button>
    </form>
</footer>
<style>
    .safe-area-bottom {
    padding-bottom: env(safe-area-inset-bottom, 16px);
}

/* Mobile par keyboard ke upar input dikhe uske liye */
@media (max-width: 640px) {
    #msg-form {
        padding-left: 4px;
        padding-right: 4px;
    }
}
</style>

