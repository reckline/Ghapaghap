<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ghapagap - Deposit Funds</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .bg-pink-theme { background-color: rgb(240, 119, 139); }
        body { background-color: black; color: white; }
        .glass-card { background: rgba(24, 24, 27, 0.8); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.1); }
        input::-webkit-outer-spin-button, input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
    </style>
</head>
<body class="bg-black text-white min-h-screen flex flex-col items-center p-4">

    <div class="w-full max-w-md flex items-center justify-between mt-6 mb-4 px-2">
        <a href="/profile" class="w-10 h-10 flex items-center justify-center rounded-full bg-zinc-800"><i class="fas fa-chevron-left"></i></a>
        <h1 class="text-xl font-black">Add Money</h1>
        <div class="w-10"></div>
    </div>

    <div id="mainCard" class="w-full max-w-md glass-card rounded-[2.5rem] p-8 mt-4">
        <div class="text-center mb-8">
            <p class="text-gray-400 text-xs font-bold uppercase tracking-widest">Current Balance</p>
            <h2 class="text-3xl font-black text-pink-400">₹<%= user.walletBalance.toFixed(2) %></h2>
        </div>

        <form id="depositForm" class="space-y-6">
            <div class="relative">
                <input type="number" id="amountInput" placeholder="Enter Amount" required 
                    value="<%= typeof amount !== 'undefined' ? amount : '' %>"
                    class="w-full px-6 py-5 bg-black/40 border border-white/10 rounded-2xl outline-none focus:ring-2 focus:ring-pink-400 text-2xl font-bold text-center text-white">
            </div>
            
            <% if (typeof packName !== 'undefined' && packName) { %>
                <p class="text-center text-pink-400 text-[10px] font-bold uppercase tracking-widest -mt-2">
                    ✨ Selected Plan: <%= packName %>
                </p>
            <% } %>

            <button type="submit" class="w-full bg-pink-theme text-white py-5 rounded-2xl font-black shadow-lg active:scale-95 transition-all text-lg tracking-wider">
                DEPOSIT NOW
            </button>
        </form>
    </div>

    <div id="upiModal" class="fixed inset-0 bg-black/95 backdrop-blur-md hidden flex-col items-center justify-center p-6 z-50">
        <div class="w-full max-w-sm glass-card rounded-[2.5rem] p-8 text-center border-pink-400/20">
            <h2 class="text-xl font-bold mb-6 italic text-pink-400">Select Payment App</h2>
            <div class="grid grid-cols-2 gap-4">
                <div onclick="openUPIApp('Google Pay')" class="p-4 bg-zinc-900/50 border border-white/5 rounded-2xl cursor-pointer hover:border-pink-400/50 transition-all">
                    <img src="https://cdn-icons-png.flaticon.com/512/2991/2991148.png" class="w-10 mx-auto mb-2">
                    <p class="text-[10px] font-bold">Google Pay</p>
                </div>
                <div onclick="openUPIApp('PhonePe')" class="p-4 bg-zinc-900/50 border border-white/5 rounded-2xl cursor-pointer hover:border-pink-400/50 transition-all">
                    <img src="https://img.icons8.com/color/48/phone-pe.png" class="w-10 mx-auto mb-2">
                    <p class="text-[10px] font-bold">PhonePe</p>
                </div>
                <div onclick="openUPIApp('Paytm')" class="p-4 bg-zinc-900/50 border border-white/5 rounded-2xl cursor-pointer hover:border-pink-400/50 transition-all">
                    <img src="https://img.icons8.com/color/48/paytm.png" class="w-10 mx-auto mb-2">
                    <p class="text-[10px] font-bold">Paytm</p>
                </div>
                <div onclick="openUPIApp('BHIM UPI')" class="p-4 bg-zinc-900/50 border border-white/5 rounded-2xl cursor-pointer hover:border-pink-400/50 transition-all">
                    <img src="https://img.icons8.com/color/48/bhim.png" class="w-10 mx-auto mb-2">
                    <p class="text-[10px] font-bold">BHIM UPI</p>
                </div>
            </div>
            <button onclick="closeModal('upiModal')" class="mt-6 text-zinc-500 font-bold text-sm underline">Cancel</button>
        </div>
    </div>

    <div id="processingPage" class="fixed inset-0 bg-black hidden flex-col items-center justify-center p-6 z-[60]">
        <div class="text-center w-full max-w-sm">
            <div class="w-20 h-20 border-4 border-pink-400 border-t-transparent rounded-full animate-spin mx-auto mb-8"></div>
            <h2 class="text-2xl font-black mb-2">Verify Payment</h2>
            <p class="text-gray-400 text-sm mb-8 px-6">Complete payment of <b class="text-white">₹<span class="procAmt">0</span></b> on your app.</p>
            
            <div class="glass-card p-6 rounded-3xl mb-10 border-white/5 text-center">
                <p class="text-xs text-gray-500 mb-1 font-bold uppercase tracking-widest">Admin UPI Address</p>
                <h3 class="text-lg font-mono text-cyan-400" id="currentUpiDisplay"><%= adminUpi %></h3>
            </div>

            <button onclick="finalizePayment()" id="finalBtn" class="w-full bg-white text-black py-5 rounded-2xl font-black text-lg shadow-2xl active:scale-95 transition-all">
                I HAVE COMPLETED PAYMENT
            </button>
            <button onclick="location.reload()" class="mt-4 text-gray-500 text-sm font-bold">Cancel Request</button>
        </div>
    </div>

    <script>
        let globalAmount = 0;
        let selectedApp = 'Other';

        const MY_UPI_ID = "<%= adminUpi %>"; 
        const MY_NAME = "<%= adminName %>";

        // 🆕 AUTO-FILL LOGIC: Page load par agar amount hai toh global variable set kar do
        window.addEventListener('DOMContentLoaded', () => {
            const amountVal = document.getElementById('amountInput').value;
            if(amountVal) {
                globalAmount = amountVal;
            }
        });

        document.getElementById('depositForm').addEventListener('submit', (e) => {
            e.preventDefault();
            globalAmount = document.getElementById('amountInput').value;
            
            if(MY_UPI_ID === "" || MY_UPI_ID.includes("notset")) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Admin has not configured UPI gateway.' });
                return;
            }

            if(globalAmount <= 0) return;

            document.querySelectorAll('.procAmt').forEach(el => el.innerText = globalAmount);
            document.getElementById('upiModal').classList.remove('hidden');
        });

        function openUPIApp(appName) {
            selectedApp = appName;
            const note = `Wallet Recharge - ${Math.floor(1000 + Math.random() * 9000)}`;
            const upiUrl = `upi://pay?pa=${MY_UPI_ID}&pn=${encodeURIComponent(MY_NAME)}&am=${globalAmount}&cu=INR&tn=${encodeURIComponent(note)}`;

            document.getElementById('upiModal').classList.add('hidden');
            document.getElementById('processingPage').classList.remove('hidden');

            window.location.href = upiUrl;
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        async function finalizePayment() {
            const { value: txnId } = await Swal.fire({
                title: 'Enter UTR / Txn ID',
                text: 'Enter the 12-digit transaction ID from your app.',
                input: 'text',
                inputPlaceholder: 'Example: 41238844...',
                showCancelButton: true,
                background: '#18181b', color: '#fff', confirmButtonColor: '#f0778b'
            });

            if (!txnId) return;

            const btn = document.getElementById('finalBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> VERIFYING...';

            try {
                const response = await fetch('/deposit-finalize', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        amount: globalAmount,
                        paymentApp: selectedApp,
                        transactionId: txnId,
                        adminUpiUsed: MY_UPI_ID
                    })
                });

                const res = await response.json();
                if (res.success) {
                    Swal.fire({ icon: 'success', title: 'Submitted', text: res.message, background: '#18181b', color: '#fff' })
                    .then(() => window.location.href = '/profile');
                } else {
                    throw new Error(res.message);
                }
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Failed', text: err.message, background: '#18181b', color: '#fff' });
                btn.disabled = false;
                btn.innerText = "I HAVE COMPLETED PAYMENT";
            }
        }
    </script>
</body>
</html>