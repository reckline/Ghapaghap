<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <title>GhapaGhap | Professional Video Sharing</title>
    <style>
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #0f0f0f; }
        ::-webkit-scrollbar-thumb { background: #333; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #444; }
        .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        #mobile-sidebar { transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .no-scrollbar::-webkit-scrollbar { display: none; }
    </style>
</head>
<body class="bg-[#0f0f0f] text-white font-sans antialiased selection:bg-pink-500/30">

    <div id="sidebar-overlay" class="fixed inset-0 bg-black/70 z-[70] hidden opacity-0 transition-opacity duration-300"></div>

    <aside id="mobile-sidebar" class="fixed top-0 left-0 w-72 h-full bg-[#0f0f0f] z-[80] -translate-x-full border-r border-gray-800 p-5 overflow-y-auto">
        <% if (user) { %>
            <%- include('../partials/mobWithLogin') %>
        <% } else { %>
            <%- include('../partials/mobWithoutLogin') %>
        <% } %>
    </aside>

    <nav class="fixed top-0 z-50 w-full bg-[#0f0f0f]/90 backdrop-blur-md flex items-center justify-between px-4 h-16 border-b border-gray-800">
        <% if (user) { %>
            <%- include('../partials/headerWithLogin') %>
        <% } else { %>
            <%- include('../partials/headerWithoutLogin') %>
        <% } %>
    </nav>

    <div class="flex">
        <% if (user) { %>
            <%- include('../partials/desktopWithLogin') %>
        <% } else { %>
            <%- include('../partials/desktopWithoutLogin') %>
        <% } %>

        <main class="flex-1 lg:ml-64 mt-16 p-4 md:p-6 lg:p-8 pb-24 lg:pb-8 overflow-x-hidden">
            
            <%- include('../partials/topNav') %>

            <% if (typeof creators !== 'undefined' && creators.length > 0) { %>
            <section class="mb-10">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl md:text-2xl font-bold flex items-center gap-2">
                        <i class="fa-solid fa-crown text-yellow-500"></i> Top Creators
                    </h2>
                    <a href="/all-creators" class="text-xs text-pink-500 font-medium hover:text-pink-400">View All</a>
                </div>

                <div class="flex gap-4 overflow-x-auto no-scrollbar pb-2">
                    <% creators.forEach((creator, index) => { %>
                        <div class="min-w-[140px] md:min-w-[170px] bg-zinc-900/40 p-5 rounded-[2.5rem] border border-gray-800/50 flex flex-col items-center text-center group hover:border-pink-500/30 transition-all">
                            <div class="relative mb-3">
                                <img src="<%= creator.avatar %>" alt="avatar" class="w-20 h-20 rounded-full object-cover ring-2 ring-gray-800 group-hover:ring-pink-500 transition-all">
                                <span class="absolute -top-1 -right-1 bg-pink-600 text-[10px] font-bold px-2 py-0.5 rounded-full border-2 border-[#0f0f0f]">
                                    #<%= index + 1 %>
                                </span>
                            </div>
                            
                            <h3 class="text-sm font-bold truncate w-full mb-1">
                                <%= creator.fullname || creator.username %>
                                <% if(creator.isVerified) { %>
                                    <i class="fas fa-check-circle text-blue-500 text-[10px]"></i>
                                <% } %>
                            </h3>
                            
                            <p class="text-[10px] text-gray-500 mb-4 font-medium uppercase tracking-wider">
                                <%= creator.subscribersCount %> Subscribers
                            </p>

                            <button onclick="handleHomeSub('<%= creator._id %>')" 
                                id="home-sub-<%= creator._id %>"
                                class="w-full py-2 rounded-xl text-[10px] font-black uppercase tracking-tighter transition-all <%= creator.isSubbed ? 'bg-zinc-800 text-gray-400' : 'bg-white text-black hover:bg-pink-600 hover:text-white' %>">
                                <%= creator.isSubbed ? 'Subscribed' : 'Subscribe' %>
                            </button>
                        </div>
                    <% }) %>
                </div>
            </section>
            <hr class="border-gray-800/50 mb-8">
            <% } %>

            <%- include('../partials/searchPage') %>
        </main>
    </div>

    <%- include('../partials/homeFooter') %>

    <script>
    // --- SIDEBAR LOGIC ---
    const sidebar = document.getElementById('mobile-sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    const body = document.body;

    function toggleSidebar() {
        const isOpen = !sidebar.classList.contains('-translate-x-full');
        if (!isOpen) {
            sidebar.classList.remove('-translate-x-full');
            overlay.classList.remove('hidden');
            setTimeout(() => overlay.classList.add('opacity-100'), 10);
            body.style.overflow = 'hidden';
        } else {
            sidebar.classList.add('-translate-x-full');
            overlay.classList.remove('opacity-100');
            setTimeout(() => {
                overlay.classList.add('hidden');
                body.style.overflow = '';
            }, 300);
        }
    }

    overlay.addEventListener('click', toggleSidebar);

    // --- HOME SUBSCRIBE LOGIC ---
    async function handleHomeSub(userId) {
        try {
            const res = await fetch(`/subscribe/${userId}`, { method: 'POST' });
            const data = await res.json();
            
            if (data.success) {
                const btn = document.getElementById(`home-sub-${userId}`);
                if (data.status === 'subscribed') {
                    btn.innerText = 'Subscribed';
                    btn.className = "w-full py-2 rounded-xl text-[10px] font-black uppercase tracking-tighter transition-all bg-zinc-800 text-gray-400";
                } else {
                    btn.innerText = 'Subscribe';
                    btn.className = "w-full py-2 rounded-xl text-[10px] font-black uppercase tracking-tighter transition-all bg-white text-black hover:bg-pink-600 hover:text-white";
                }
            } else {
                window.location.href = '/login';
            }
        } catch (err) {
            console.error("Sub Error:", err);
        }
    }

    // Escape Key support
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !sidebar.classList.contains('-translate-x-full')) toggleSidebar();
    });
    </script>
</body>
</html>