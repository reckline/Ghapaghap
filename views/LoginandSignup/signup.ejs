<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ghapagap - Join Now</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <style>
        .brand-pink { color: rgb(240, 119, 139); }
        .bg-pink-theme { background-color: rgb(240, 119, 139); }
        .shadow-pink { box-shadow: 0 10px 25px -5px rgba(240, 119, 139, 0.4); }
        body { background-color: black; }
    </style>
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">

<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

<script>
    // URL se error ya success message nikalne ke liye
    const urlParams = new URLSearchParams(window.location.search);
    const error = urlParams.get('error');
    const success = urlParams.get('success');

    if (error) {
        Toastify({
            text: error,
            duration: 3000,
            gravity: "top", 
            position: "right", 
            style: { background: "linear-gradient(to right, #ff5f6d, #ffc371)" }
        }).showToast();
    }

    if (success) {
        Toastify({
            text: success,
            duration: 3000,
            gravity: "top",
            position: "right",
            style: { background: "linear-gradient(to right, #00b09b, #96c93d)" }
        }).showToast();
    }
</script>
</head>
<body class="bg-black flex items-center justify-center min-h-screen p-4 overflow-x-hidden">

    <div class="fixed top-0 left-0 w-full h-full -z-10 overflow-hidden">
        <div class="absolute top-[-10%] right-[-10%] w-[50%] h-[50%] bg-pink-900/20 rounded-full blur-[120px] opacity-60"></div>
        <div class="absolute bottom-[-10%] left-[-10%] w-[50%] h-[50%] bg-pink-900/10 rounded-full blur-[120px] opacity-60"></div>
    </div>

    <div class="relative w-full max-w-2xl bg-zinc-900/80 backdrop-blur-xl rounded-[2.5rem] shadow-2xl border border-white/10 p-8 md:p-12">
        
        <a href="/" class="absolute top-6 right-8 text-gray-500 hover:text-pink-400 transition-all duration-300 hover:rotate-90">
            <div style="position: relative; top: -1rem; right: -1rem; border-radius: 50%; height: 2rem; width: 2rem; display: flex; align-items: center; justify-content: center;">
              <i class="fas fa-times text-2xl"></i>
            </div>
        </a>

        <div class="text-center mb-10">
            <h1 class="text-4xl font-black text-white tracking-tight">Create Account</h1>
            <p class="text-gray-400 mt-2 font-medium">Join the <span class="brand-pink font-bold">Ghapagap</span> community today!</p>
        </div>

        <form action="/signup" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <div class="space-y-2">
                <label class="text-sm font-bold text-gray-300 ml-1">Full Name</label>
                <div class="relative">
                    <i class="fas fa-id-card absolute left-4 top-1/2 -translate-y-1/2 text-gray-500"></i>
                    <input type="text" name="fullname" required 
                        class="w-full pl-12 pr-4 py-3.5 bg-black/40 border border-white/10 rounded-2xl text-white focus:ring-2 focus:ring-pink-400 outline-none transition-all placeholder:text-gray-600"
                        placeholder="John Doe">
                </div>
            </div>

            <div class="space-y-2">
                <label class="text-sm font-bold text-gray-300 ml-1">Username</label>
                <div class="relative">
                    <i class="fas fa-at absolute left-4 top-1/2 -translate-y-1/2 text-gray-500"></i>
                    <input type="text" name="username" required 
                        class="w-full pl-12 pr-4 py-3.5 bg-black/40 border border-white/10 rounded-2xl text-white focus:ring-2 focus:ring-pink-400 outline-none transition-all placeholder:text-gray-600"
                        placeholder="john_ghapagap">
                </div>
            </div>

            <div class="space-y-2">
                <label class="text-sm font-bold text-gray-300 ml-1">Mobile Number</label>
                <div class="relative">
                    <i class="fas fa-phone absolute left-4 top-1/2 -translate-y-1/2 text-gray-500"></i>
                    <input type="tel" name="phone" required maxlength="10"
                        oninput="this.value = this.value.replace(/[^0-9]/g, '');"
                        class="w-full pl-12 pr-4 py-3.5 bg-black/40 border border-white/10 rounded-2xl text-white focus:ring-2 focus:ring-pink-400 outline-none transition-all placeholder:text-gray-600"
                        placeholder="0000000000">
                </div>
            </div>

            <div class="space-y-2">
                <label class="text-sm font-bold text-gray-300 ml-1">Email (Optional)</label>
                <div class="relative">
                    <i class="fas fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-gray-500"></i>
                    <input type="email" name="email" 
                        class="w-full pl-12 pr-4 py-3.5 bg-black/40 border border-white/10 rounded-2xl text-white focus:ring-2 focus:ring-pink-400 outline-none transition-all placeholder:text-gray-600"
                        placeholder="john@example.com">
                </div>
            </div>

            <div class="space-y-2">
                <label class="text-sm font-bold text-gray-300 ml-1">Password</label>
                <div class="relative">
                    <i class="fas fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-gray-500"></i>
                    <input id="pass" type="password" name="password" required 
                        class="w-full pl-12 pr-12 py-3.5 bg-black/40 border border-white/10 rounded-2xl text-white focus:ring-2 focus:ring-pink-400 outline-none transition-all placeholder:text-gray-600"
                        placeholder="••••••••">
                    <button type="button" onclick="toggleView('pass', 'eye1')" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-pink-400">
                        <i id="eye1" class="fas fa-eye"></i>
                    </button>
                </div>
            </div>

            <div class="space-y-2">
                <label class="text-sm font-bold text-gray-300 ml-1">Confirm Password</label>
                <div class="relative">
                    <i class="fas fa-check-double absolute left-4 top-1/2 -translate-y-1/2 text-gray-500"></i>
                    <input id="confirm" type="password" name="confirm_password" required 
                        class="w-full pl-12 pr-12 py-3.5 bg-black/40 border border-white/10 rounded-2xl text-white focus:ring-2 focus:ring-pink-400 outline-none transition-all placeholder:text-gray-600"
                        placeholder="••••••••">
                    <button type="button" onclick="toggleView('confirm', 'eye2')" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-pink-400">
                        <i id="eye2" class="fas fa-eye"></i>
                    </button>
                </div>
            </div>

            <div class="md:col-span-2 flex items-start space-x-3 py-2">
                <input type="checkbox" required class="mt-1 w-5 h-5 accent-pink-500 bg-black border-white/20 rounded">
                <p class="text-xs text-gray-400 leading-relaxed">
                    By clicking "Create Account", I agree to Ghapagap's 
                </p>
            </div>

            <div class="md:col-span-2 mt-4">
                <button type="submit" 
                    class="w-full bg-pink-theme text-white py-4 rounded-2xl font-black text-lg shadow-pink hover:scale-[1.01] active:scale-[0.99] transition-all duration-200 uppercase tracking-widest">
                    Create Account
                </button>
            </div>
        </form>

        <div class="mt-10 text-center">
            <p class="text-gray-400 font-medium">Already have an account? 
                <a href="/login" class="brand-pink font-black hover:underline underline-offset-4">LOG IN</a>
            </p>
        </div>
    </div>

    <script>
        function toggleView(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }
    </script>
</body>
</html>